# Gestionado por Ameriboard.
# Incluir dentro del bloque server elegido.
# Usa el socket estable del servicio y BASE_PATH=/ameriboard.

location = /ameriboard {
    return 301 /ameriboard/$is_args$args;
}

# Reservado para WebSockets: debe existir un endpoint en el backend para usarse.
location /ameriboard/ws {
    proxy_pass http://unix:/run/ameriboard/proxy.sock;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /ameriboard;
    proxy_buffering off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
}

# Sin URI en proxy_pass se conserva /ameriboard/ al enviar la petición a Go.
location /ameriboard/ {
    proxy_pass http://unix:/run/ameriboard/proxy.sock;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /ameriboard;
    proxy_read_timeout 1h;
}
