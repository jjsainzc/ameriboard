[Unit]
Description=Ameriboard
After=network.target

[Service]
Type=notify
EnvironmentFile=/etc/ameriboard/ameriboard.env
ExecStart=/usr/bin/ameriboard -config /etc/ameriboard/ameriboard.yaml -proxy-socket /run/ameriboard/proxy.sock
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ameriboard
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
RuntimeDirectory=ameriboard
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
